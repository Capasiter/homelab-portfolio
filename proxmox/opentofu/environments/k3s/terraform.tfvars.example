proxmox_endpoint  = "https://proxmox.example.com:8006/"
proxmox_api_token = "automation@pve!opentofu=REPLACE_WITH_TOKEN_SECRET"
proxmox_insecure  = true

node_name      = "pve"
template_vm_id = 9100
datastore_id   = "local-lvm"
bridge         = "vmbr0"

cpu_cores = 2
cpu_type  = "host"
memory    = 3072
disk_size = 32

username            = "ansible"
ssh_public_key_path = "~/.ssh/homelab_ansible_ed25519.pub"
